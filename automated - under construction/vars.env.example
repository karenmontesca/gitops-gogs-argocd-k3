# Copy this file to vars.env and fill it in:  cp vars.env.example vars.env
# vars.env is in .gitignore. NEVER commit it: it holds your agent key and passwords.
# Wrap values in single quotes if they contain special characters:  GOGS_ADMIN_PASSWORD='p&ss|word'

# --- Network (must already be configured, see the main README, steps 1 and 2) ---
PROXY_NAT_IP=192.168.189.150   # vm-proxy-git, internet-facing adapter
PROXY_INT_IP=10.10.10.40       # vm-proxy-git, internal adapter (also the proxy address)
K3_IP=10.10.10.60              # vm-k3-git
NAT_IFACE=ens160               # vm-proxy-git NAT interface name
INT_IFACE=ens224               # vm-proxy-git internal interface name
K3_IFACE=ens160                # vm-k3-git interface name

# --- Instana (Settings > Agents > Installation > Kubernetes) ---
INSTANA_AGENT_KEY=''
INSTANA_ENDPOINT_HOST=         # e.g. ingress-xxxx-saas.instana.io
INSTANA_ENDPOINT_PORT=443

# --- Gogs (the admin account and repo the scripts will create) ---
GOGS_ADMIN_USER=root
GOGS_ADMIN_PASSWORD=''
GOGS_REPO=instana-gitops-lab

# --- Optional ---
CLUSTER_NAME=instana-lab
ZONE_NAME=gogs-instana-lab-zone
# ARGOCD_ADMIN_PASSWORD=       # only needed if you already changed ArgoCD's admin password
